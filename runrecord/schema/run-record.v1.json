{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fishing-agents/neocloud-catalog/runrecord/schema/run-record.v1.json",
  "title": "run-record/v1",
  "description": "One serving configuration of a model on some hardware, observed over one window, with its outcome. No tenant, host or request data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "record_id", "install_id", "platform", "observed_from", "observed_to", "model", "config", "outcome", "workload"],
  "properties": {
    "schema": {"const": "run-record/v1"},
    "record_id": {"$ref": "#/$defs/uuid", "description": "Idempotency key: a resent record keeps its id."},
    "install_id": {"$ref": "#/$defs/uuid", "description": "Random id persisted by the reporter; no relation to the platform install."},
    "platform": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$", "description": "Adapter name, e.g. gpustack, airunway."},
    "platform_version": {"type": "string"},
    "observed_from": {"type": "string", "format": "date-time"},
    "observed_to": {"type": "string", "format": "date-time"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "repo", "quantization"],
      "properties": {
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slug", "version"],
          "properties": {
            "slug": {"type": "string", "minLength": 1},
            "preset": {"type": "string"},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "source": {"enum": ["huggingface", "modelscope"]},
        "repo": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "revision": {"type": "string"},
        "quantization": {"type": "string", "minLength": 1},
        "params_b": {"type": "number", "minimum": 0},
        "weights_gb": {"type": "number", "minimum": 0}
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "tensor_parallel", "max_context", "gpu_model", "gpu_count", "gpu_memory_gb", "nodes"],
      "properties": {
        "backend": {"enum": ["vllm", "sglang"]},
        "backend_version": {"type": "string"},
        "image_digest": {"type": "string"},
        "args": {
          "type": "array",
          "description": "Allowlisted launch flags: runrecord.SwitchArgs as --flag, runrecord.ValueArgs as --flag=value with a plain value.",
          "items": {"type": "string", "pattern": "^--[a-z0-9-]+(=[A-Za-z0-9._:+-]{1,64})?$"}
        },
        "tensor_parallel": {"type": "integer", "minimum": 1},
        "pipeline_parallel": {"type": "integer", "minimum": 1},
        "max_context": {"type": "integer", "minimum": 1},
        "gpu_model": {"type": "string", "minLength": 1},
        "gpu_count": {"type": "integer", "minimum": 1},
        "gpu_memory_gb": {"type": "number", "exclusiveMinimum": 0},
        "interconnect": {"type": "string"},
        "nodes": {"type": "integer", "minimum": 1}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["ran", "failed"]},
        "failure": {"enum": ["oom", "crash", "unschedulable", "timeout", "other"]},
        "reason": {"type": "string", "maxLength": 200},
        "vram_used_gb": {"type": "number", "minimum": 0},
        "output_tokens_per_sec": {"type": "number", "minimum": 0},
        "total_tokens_per_sec": {"type": "number", "minimum": 0},
        "ttft_p50_ms": {"type": "number", "minimum": 0},
        "ttft_p95_ms": {"type": "number", "minimum": 0},
        "itl_p50_ms": {"type": "number", "minimum": 0},
        "itl_p95_ms": {"type": "number", "minimum": 0},
        "concurrency_mean": {"type": "number", "minimum": 0},
        "concurrency_max": {"type": "number", "minimum": 0},
        "requests_ok": {"type": "integer", "minimum": 0},
        "requests_failed": {"type": "integer", "minimum": 0}
      },
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {"required": ["failure"]},
      "else": {"not": {"required": ["failure"]}}
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "input_tokens", "output_tokens"],
      "properties": {
        "source": {"enum": ["benchmark-standard", "benchmark-operator", "live"]},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "concurrency": {"type": "integer", "minimum": 1},
        "requests": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
  }
}
