{
  "kind": "app",
  "slug": "mlflow",
  "version": "1.11.7",
  "status": "preview",
  "name": "MLflow",
  "description": "MLflow tracking server and model registry. Uses the tenant's own Postgres and S3, or a bundled Postgres and MinIO.",
  "category": "ML ops",
  "icon": "https://raw.githubusercontent.com/mlflow/mlflow/master/assets/logo.svg",
  "upstream_chart_ref": "oci://ghcr.io/fishing-agents/charts/mlflow:1.11.7",
  "chart_digest": null,
  "pending_publish": true,
  "app_kind": "chart",
  "requests": {
    "cpu": "1",
    "memory": "2Gi",
    "gpu": null
  },
  "requires": [],
  "expose": {
    "service": "mlflow",
    "port": 80
  },
  "pinned_values": {
    "fullnameOverride": "mlflow",
    "service": {
      "type": "ClusterIP"
    },
    "ingress": {
      "enabled": false
    },
    "serviceMonitor": {
      "enabled": false
    },
    "podSecurityContext": {
      "runAsNonRoot": true,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "securityContext": {
      "runAsNonRoot": true,
      "allowPrivilegeEscalation": false,
      "privileged": false,
      "capabilities": {
        "drop": [
          "ALL"
        ]
      },
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "postgresql": {
      "architecture": "standalone",
      "primary": {
        "networkPolicy": {
          "enabled": false
        },
        "service": {
          "type": "ClusterIP"
        },
        "podSecurityContext": {
          "enabled": true,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containerSecurityContext": {
          "enabled": true,
          "runAsNonRoot": true,
          "allowPrivilegeEscalation": false,
          "privileged": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        }
      },
      "volumePermissions": {
        "enabled": false
      },
      "metrics": {
        "enabled": false
      },
      "rbac": {
        "create": false
      }
    },
    "minio": {
      "mode": "standalone",
      "service": {
        "type": "ClusterIP"
      },
      "consoleService": {
        "type": "ClusterIP"
      },
      "ingress": {
        "enabled": false
      },
      "consoleIngress": {
        "enabled": false
      },
      "networkPolicy": {
        "enabled": false
      },
      "metrics": {
        "serviceMonitor": {
          "enabled": false
        }
      },
      "persistence": {
        "enabled": true
      },
      "securityContext": {
        "enabled": true,
        "runAsNonRoot": true,
        "runAsUser": 1000,
        "runAsGroup": 1000,
        "fsGroup": 1000,
        "seccompProfile": {
          "type": "RuntimeDefault"
        }
      },
      "containerSecurityContext": {
        "runAsNonRoot": true,
        "allowPrivilegeEscalation": false,
        "capabilities": {
          "drop": [
            "ALL"
          ]
        }
      },
      "postJob": {
        "securityContext": {
          "enabled": true,
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "runAsGroup": 1000,
          "fsGroup": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        }
      },
      "makeBucketJob": {
        "securityContext": {
          "enabled": true
        },
        "containerSecurityContext": {
          "runAsNonRoot": true,
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        }
      }
    }
  },
  "form_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "replicaCount": {
        "title": "Replicas",
        "type": "integer",
        "minimum": 1,
        "maximum": 5,
        "default": 1
      },
      "serverAllowedHosts": {
        "title": "Allowed hosts",
        "description": "Host names the tracking server answers to, such as the app's Ingress host when exposed",
        "type": "array",
        "items": {
          "type": "string",
          "format": "hostname"
        }
      },
      "auth": {
        "title": "Basic authentication",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "adminUsername": {
            "type": "string",
            "minLength": 1
          },
          "adminPassword": {
            "type": "string",
            "minLength": 8,
            "writeOnly": true
          }
        }
      },
      "backendStore": {
        "title": "External Postgres",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "postgres": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              },
              "host": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "default": 5432
              },
              "database": {
                "type": "string",
                "minLength": 1
              },
              "user": {
                "type": "string",
                "minLength": 1
              },
              "password": {
                "type": "string",
                "writeOnly": true
              }
            }
          }
        }
      },
      "postgresql": {
        "title": "Bundled Postgres",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "username": {
                "type": "string",
                "minLength": 1
              },
              "password": {
                "type": "string",
                "minLength": 8,
                "writeOnly": true
              }
            }
          },
          "primary": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "persistence": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "size": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$",
                    "default": "8Gi"
                  }
                }
              }
            }
          }
        }
      },
      "artifactRoot": {
        "title": "Artifact storage",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "proxiedArtifactStorage": {
            "description": "Serve artifacts through the tracking server, so clients need no S3 credentials",
            "type": "boolean",
            "default": false
          },
          "s3": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              },
              "bucket": {
                "type": "string",
                "minLength": 3
              },
              "path": {
                "type": "string"
              },
              "awsAccessKeyId": {
                "type": "string"
              },
              "awsSecretAccessKey": {
                "type": "string",
                "writeOnly": true
              }
            }
          }
        }
      },
      "extraEnvVars": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "MLFLOW_S3_ENDPOINT_URL": {
            "title": "S3 endpoint",
            "description": "The endpoint of an S3-compatible store other than AWS",
            "type": "string",
            "format": "uri"
          }
        }
      },
      "minio": {
        "title": "Bundled MinIO",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "description": "Needs artifactRoot.s3.enabled",
            "type": "boolean",
            "default": false
          },
          "rootUser": {
            "type": "string",
            "minLength": 3
          },
          "rootPassword": {
            "type": "string",
            "minLength": 8,
            "writeOnly": true
          },
          "persistence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "size": {
                "type": "string",
                "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$",
                "default": "10Gi"
              }
            }
          }
        }
      }
    }
  }
}
