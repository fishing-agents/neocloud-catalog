{
  "kind": "app",
  "slug": "flowise",
  "version": "6.0.0",
  "status": "preview",
  "name": "Flowise",
  "description": "Flowise drag-and-drop builder for LLM flows and agents. Stores its data in SQLite on a volume, a bundled Postgres or the tenant's own Postgres.",
  "category": "LLM apps",
  "icon": "https://avatars.githubusercontent.com/u/128289781",
  "upstream_chart_ref": "oci://ghcr.io/cowboysysop/charts/flowise:6.0.0",
  "chart_digest": "sha256:4fcfadf53c24aa717b0ce1d0664bd39f6100e50d50034d0663b4c61a061a14bd",
  "app_kind": "chart",
  "requests": {
    "cpu": "500m",
    "memory": "1Gi",
    "gpu": null
  },
  "requires": [],
  "expose": {
    "service": "flowise",
    "port": 3000
  },
  "pinned_values": {
    "fullnameOverride": "flowise",
    "service": {
      "type": "ClusterIP"
    },
    "ingress": {
      "enabled": false
    },
    "worker": {
      "enabled": false
    },
    "podSecurityContext": {
      "runAsNonRoot": true,
      "runAsUser": 1000,
      "runAsGroup": 1000,
      "fsGroup": 1000,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "securityContext": {
      "runAsNonRoot": true,
      "runAsUser": 1000,
      "runAsGroup": 1000,
      "allowPrivilegeEscalation": false,
      "capabilities": {
        "drop": [
          "ALL"
        ]
      }
    },
    "extraEnvVars": [
      {
        "name": "LOG_PATH",
        "value": "/data/logs"
      }
    ],
    "postgresql": {
      "architecture": "standalone",
      "primary": {
        "networkPolicy": {
          "enabled": false
        },
        "service": {
          "type": "ClusterIP"
        },
        "podSecurityContext": {
          "enabled": true,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containerSecurityContext": {
          "enabled": true,
          "runAsNonRoot": true,
          "allowPrivilegeEscalation": false,
          "privileged": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        }
      },
      "volumePermissions": {
        "enabled": false
      },
      "metrics": {
        "enabled": false
      },
      "rbac": {
        "create": false
      }
    }
  },
  "form_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "config": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "encryptionKey": {
            "title": "Encryption key",
            "description": "Encrypts stored credentials; generated on the data volume when empty",
            "type": "string",
            "writeOnly": true
          }
        }
      },
      "persistence": {
        "title": "Data volume",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "size": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$",
            "default": "1Gi"
          }
        }
      },
      "postgresql": {
        "title": "Bundled Postgres",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "password": {
                "type": "string",
                "minLength": 8,
                "writeOnly": true
              }
            }
          },
          "primary": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "persistence": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "size": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$",
                    "default": "8Gi"
                  }
                }
              }
            }
          }
        }
      },
      "externalPostgresql": {
        "title": "External Postgres",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "host": {
            "type": "string",
            "format": "hostname"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 5432
          },
          "username": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "writeOnly": true
          },
          "database": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
