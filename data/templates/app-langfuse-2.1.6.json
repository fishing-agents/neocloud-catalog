{
  "kind": "app",
  "slug": "langfuse",
  "version": "2.1.6",
  "status": "preview",
  "name": "Langfuse",
  "description": "Langfuse LLM tracing, evaluations and prompt management. Needs the tenant's ClickHouse; Postgres, Valkey and SeaweedFS S3 are bundled or the tenant's own.",
  "category": "LLM observability",
  "icon": "https://langfuse.com/langfuse_logo.png",
  "upstream_chart_ref": "oci://ghcr.io/langfuse/langfuse-k8s/charts/langfuse:2.1.6",
  "chart_digest": "sha256:70689174ae462b82cc54e3d648b76adde308ed2ab57ed8785cd595bd4fe5b590",
  "app_kind": "chart",
  "requests": {
    "cpu": "2",
    "memory": "4Gi",
    "gpu": null
  },
  "requires": [],
  "expose": {
    "service": "langfuse-web",
    "port": 3000
  },
  "pinned_values": {
    "fullnameOverride": "langfuse",
    "global": {
      "seaweedfs": {
        "createClusterRole": false,
        "monitoring": {
          "enabled": false
        }
      }
    },
    "langfuse": {
      "ingress": {
        "enabled": false
      },
      "podSecurityContext": {
        "runAsNonRoot": true,
        "runAsUser": 1001,
        "runAsGroup": 1001,
        "seccompProfile": {
          "type": "RuntimeDefault"
        }
      },
      "securityContext": {
        "allowPrivilegeEscalation": false,
        "capabilities": {
          "drop": [
            "ALL"
          ]
        }
      },
      "web": {
        "service": {
          "type": "ClusterIP"
        },
        "keda": {
          "enabled": false
        },
        "vpa": {
          "enabled": false
        }
      },
      "worker": {
        "keda": {
          "enabled": false
        },
        "vpa": {
          "enabled": false
        }
      }
    },
    "clickhouse": {
      "deploy": false
    },
    "postgresql": {
      "service": {
        "type": "ClusterIP"
      },
      "podSecurityContext": {
        "runAsNonRoot": true,
        "fsGroup": 999,
        "seccompProfile": {
          "type": "RuntimeDefault"
        }
      },
      "securityContext": {
        "runAsNonRoot": true,
        "runAsUser": 999,
        "runAsGroup": 999,
        "allowPrivilegeEscalation": false,
        "privileged": false,
        "capabilities": {
          "drop": [
            "ALL"
          ]
        }
      }
    },
    "redis": {
      "service": {
        "type": "ClusterIP"
      },
      "metrics": {
        "enabled": false
      },
      "podSecurityContext": {
        "runAsNonRoot": true,
        "runAsUser": 1000,
        "runAsGroup": 1000,
        "fsGroup": 1000,
        "seccompProfile": {
          "type": "RuntimeDefault"
        }
      },
      "securityContext": {
        "runAsNonRoot": true,
        "allowPrivilegeEscalation": false,
        "capabilities": {
          "drop": [
            "ALL"
          ]
        }
      }
    },
    "s3": {
      "allInOne": {
        "service": {
          "type": "ClusterIP"
        },
        "podSecurityContext": {
          "enabled": true,
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "runAsGroup": 1000,
          "fsGroup": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containerSecurityContext": {
          "enabled": true,
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        }
      },
      "filer": {
        "podSecurityContext": {
          "enabled": true,
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "runAsGroup": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containerSecurityContext": {
          "enabled": true,
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        }
      }
    }
  },
  "form_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "langfuse",
      "clickhouse"
    ],
    "properties": {
      "langfuse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nextauth"
        ],
        "properties": {
          "nextauth": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "title": "Public URL",
                "description": "The URL users open Langfuse at, such as the app's Ingress URL when exposed",
                "type": "string",
                "format": "uri"
              }
            }
          },
          "features": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "signUpDisabled": {
                "title": "Disable sign-up",
                "type": "boolean",
                "default": false
              }
            }
          },
          "web": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "replicas": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "default": 1
              }
            }
          },
          "worker": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "replicas": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "default": 1
              }
            }
          }
        }
      },
      "clickhouse": {
        "title": "ClickHouse",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host",
          "auth"
        ],
        "properties": {
          "host": {
            "type": "string",
            "format": "hostname"
          },
          "httpPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 8123
          },
          "nativePort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 9000
          },
          "database": {
            "type": "string",
            "default": "default"
          },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "username",
              "password"
            ],
            "properties": {
              "username": {
                "type": "string",
                "minLength": 1
              },
              "password": {
                "type": "string",
                "writeOnly": true
              }
            }
          },
          "migration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ssl": {
                "type": "boolean",
                "default": false
              }
            }
          },
          "cluster": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "title": "Clustered ClickHouse",
                "description": "Run ON CLUSTER DDL; false for a single server",
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      },
      "postgresql": {
        "title": "Postgres",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deploy": {
            "title": "Bundled Postgres",
            "type": "boolean",
            "default": true
          },
          "host": {
            "type": "string",
            "format": "hostname"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 5432
          },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "username": {
                "type": "string",
                "minLength": 1
              },
              "password": {
                "type": "string",
                "writeOnly": true
              },
              "database": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "storage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestedSize": {
                "type": "string",
                "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$",
                "default": "20Gi"
              }
            }
          }
        }
      },
      "redis": {
        "title": "Redis",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deploy": {
            "title": "Bundled Valkey",
            "type": "boolean",
            "default": true
          },
          "host": {
            "type": "string",
            "format": "hostname"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 6379
          },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "password": {
                "type": "string",
                "writeOnly": true
              }
            }
          },
          "dataStorage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestedSize": {
                "type": "string",
                "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$",
                "default": "8Gi"
              }
            }
          }
        }
      },
      "s3": {
        "title": "Object storage",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deploy": {
            "title": "Bundled SeaweedFS",
            "type": "boolean",
            "default": true
          },
          "bucket": {
            "type": "string",
            "minLength": 3,
            "default": "langfuse"
          },
          "region": {
            "type": "string",
            "default": "auto"
          },
          "endpoint": {
            "type": "string",
            "format": "uri"
          },
          "forcePathStyle": {
            "type": "boolean",
            "default": true
          },
          "accessKeyId": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string"
              }
            }
          },
          "secretAccessKey": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string",
                "writeOnly": true
              }
            }
          },
          "allInOne": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "size": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$",
                    "default": "50Gi"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
